[Unit]
Description=ArugoBot Codeforces Discord bot
Wants=network-online.target
After=network-online.target
ConditionFileNotEmpty=/home/ubuntu/ArugoBot/token.txt
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ArugoBot
ExecStart=/home/ubuntu/ArugoBot/.venv/bin/python -u /home/ubuntu/ArugoBot/main.py
Environment=MPLBACKEND=Agg
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
